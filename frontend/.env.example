# Copy to frontend/.env to override. Vite only exposes VITE_* variables.
#
# These are inlined at BUILD time, not read at runtime — changing them on the
# host means triggering a rebuild, not just a restart.

# mock = run the entire UI on bundled sample data, no backend required (default)
# live = call the real API
#
# Set this to `live` in Vercel. Left as mock, the deployed site runs entirely on
# sample data and never touches your backend — it looks like it works while
# proving nothing.
VITE_API_MODE=mock

# Where the API lives.
#
# Leave BLANK in development: Vite proxies /api to localhost:8000, so the app
# code needs no environment switching.
#
# In production the UI is on Vercel and the API is on Render — different
# origins — so point this at the backend:
#     VITE_API_URL=https://probeai-api.onrender.com
# and add that same Vercel origin to CORS_ORIGINS on Render.
#
# Alternatively leave it blank and add a rewrite in vercel.json, which keeps
# every request same-origin and sidesteps CORS entirely. See DEPLOY.md §3.
VITE_API_URL=
