# ProbeAI — environment template. Copy to backend/.env and fill in.
#
# This file is gitignored. Never commit it, and never paste a real key into
# .env.example. Fill in the blanks below and restart the server.
#
# Loaded by backend/config.py. backend/.env wins over a repo-root .env.


# ============================================================================
# LLM PROVIDER  —  pick one
# ============================================================================

# "gemini" or "groq". Switching this is the ONLY change needed to swap
# providers; no agent code cares which one answers.
LLM_PROVIDER=gemini

# --- Gemini (current default) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Groq ---
# Get a key at https://console.groq.com/keys
# To use Groq: set LLM_PROVIDER=groq above, paste the key here, and confirm the
# model id against https://console.groq.com/docs/models — Groq retires ids
# fairly often, so the default below may already be stale.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile


# ============================================================================
# VOICE (ElevenLabs)  —  not wired up yet
# ============================================================================
# These are read by config.py but no code path uses them until the voice
# endpoint is built. Setting them now changes nothing.

VOICE_ENABLED=true
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5


# ============================================================================
# GENERATION TUNING
# ============================================================================
# NOTE: CONVERSATION_TEMPERATURE from the old backend no longer exists. The
# interviewer and the evaluator are separate agents now and need opposite
# settings — the interviewer should sound human, the evaluator must stay
# anchored to what was actually said — so it split into two values.

INTERVIEWER_TEMPERATURE=0.8
EVALUATOR_TEMPERATURE=0.2
FEEDBACK_TEMPERATURE=0.3

MAX_OUTPUT_TOKENS=2048
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_SECONDS=1.5
LLM_TIMEOUT_SECONDS=45


# ============================================================================
# INTERVIEW SHAPE
# ============================================================================

MIN_QUESTIONS=8
MAX_QUESTIONS=12
MIN_TOPICS=4
HISTORY_SUMMARY_THRESHOLD=6


# ============================================================================
# RAG / VECTOR STORE
# ============================================================================
# RAG_ENABLED=false forces keyword retrieval — useful for a fast local start,
# since the first Chroma run downloads a ~79MB embedding model.

RAG_ENABLED=true
RAG_COLLECTION=curriculum_objectives
RAG_TOP_K=5


# ============================================================================
# SESSIONS
# ============================================================================
# "memory" is correct for ONE worker only. With 2+ workers, requests
# round-robin and a session created on worker A is invisible to worker B.
# Supabase is not implemented yet — setting it logs a warning and uses memory.

SESSION_BACKEND=memory
SESSION_TTL_MINUTES=30
COMPLETED_SESSION_TTL_MINUTES=5
SESSION_CLEANUP_INTERVAL_SECONDS=300

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_SESSIONS_TABLE=interview_sessions


# ============================================================================
# SERVER
# ============================================================================
# CORS_ORIGINS must list your Vercel URL once the frontend is deployed, e.g.
# CORS_ORIGINS=https://probeai.vercel.app,http://localhost:5173

PORT=8000
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=*
